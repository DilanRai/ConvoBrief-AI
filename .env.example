# ==============================================================================
# ConvoBrief AI — Environment Configuration Example
# ==============================================================================

# PostgreSQL connection. Leave empty to use the embedded PGlite database in
# development; set this for PostgreSQL and all production deployments.
DATABASE_URL=""

# Keep this stable across deployments; changing it makes previously stored
# per-user provider keys unreadable.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_SECRET="replace-with-32-byte-random-hex-secret-in-production"

# ------------------------------------------------------------------------------
# Optional External LLM Provider API Keys
# (If omitted, ConvoBrief AI runs its built-in Privacy-First Hybrid NLP Engine
#  on-server, and users can also configure encrypted per-user keys in Settings.)
# ------------------------------------------------------------------------------

# OpenAI (e.g., gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=""

# Anthropic Claude (e.g., claude-3-5-sonnet-latest)
ANTHROPIC_API_KEY=""

# Google Gemini (e.g., gemini-2.5-flash)
GEMINI_API_KEY=""

# Select an environment provider when the account setting is Auto.
# Supported examples: openai, anthropic, gemini, groq, nvidia, custom.
LLM_PROVIDER=

# Groq (change GROQ_MODEL to another model available to your account)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# NVIDIA NIM (update the key and model together if your model uses a different key)
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-3-4b-it

# Optional generic OpenAI-compatible provider
LLM_API_KEY=
LLM_BASE_URL=